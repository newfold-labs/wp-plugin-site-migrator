{
	"root": true,
	"extends": ["plugin:@wordpress/eslint-plugin/recommended"],
	// This is browser code. The shared config's globals cover most of what src/ touches but not
	// FileReader, which upload.js had used unnoticed since it was written, because a
	// `plugin:cypress/recommended` extend with the plugin absent meant lint-js died before it
	// read a line of source.
	"env": { "browser": true }
}

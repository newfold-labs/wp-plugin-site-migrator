{
    "name": "newfold-labs/wp-plugin-site-migrator",
    "description": "Move a WordPress site between hosts. Export this site to a package, or import one exported from elsewhere.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Newfold Labs",
            "homepage": "https://newfold.com"
        }
    ],
    "repositories": [
        {
            "type": "composer",
            "url": "https://newfold-labs.github.io/satis/",
            "only": [
                "newfold-labs/*"
            ]
        }
    ],
    "require": {
        "wp-forge/wp-plugin-check": "^1.0"
    },
    "require-dev": {
        "newfold-labs/wp-php-standards": "^1.2"
    },
    "autoload": {
        "psr-4": {
            "NewfoldLabs\\WP\\SiteMigrator\\": "includes/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "fix": [
            "vendor/bin/phpcbf . --ignore=*/nfd-site-migrator.asset.php"
        ],
        "lint": [
            "vendor/bin/phpcs . --ignore=*/nfd-site-migrator.asset.php"
        ]
    },
    "scripts-descriptions": {
        "fix": "Automatically fix coding standards issues where possible.",
        "lint": "Check files against coding standards."
    }
}

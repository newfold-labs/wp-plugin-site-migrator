{
  "name": "nfd-site-migrator",
  "version": "0.1.1",
  "description": "Move a WordPress site between hosts. Export this site to a package, or import one exported from elsewhere.",
  "private": true,
  "main": "webpack.config.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/newfold-labs/wp-plugin-site-migrator.git"
  },
  "author": "Micah Wood <micah@wpscholar.com>",
  "license": "GPL-2.0+",
  "bugs": {
    "url": "https://github.com/newfold-labs/wp-plugin-site-migrator/issues"
  },
  "homepage": "https://github.com/newfold-labs/wp-plugin-site-migrator#readme",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@reduxjs/toolkit": "^1.9.5",
    "@tailwindcss/forms": "^0.5.4",
    "@wordpress/eslint-plugin": "^15.0.0",
    "@wordpress/prettier-config": "^2.23.0",
    "@wordpress/scripts": "^26.11.0",
    "tailwindcss": "^3.3.3",
    "watch": "^1.0.2",
    "webpack-merge": "^5.9.0"
  },
  "scripts": {
    "generate:css": "tailwindcss -i ./assets/styles/app.css -o ./src/styles/nfd-site-migrator.css",
    "build": "npm run generate:css && wp-scripts build ./src/nfd-site-migrator.js",
    "format": "wp-scripts format ./src",
    "start": "npm run generate:css && wp-scripts start ./src/nfd-site-migrator.js",
    "lint:js": "wp-scripts lint-js ./src",
    "lint:js:fix": "wp-scripts lint-js ./src --fix",
    "watch": "watch 'npm run generate:css' ./src ./assets",
    "test:e2e": "npm run test:playwright",
    "test:playwright": "playwright test",
    "wp-env": "wp-env"
  },
  "dependencies": {
    "@wordpress/api-fetch": "^6.37.0",
    "@wordpress/element": "^5.17.0",
    "@wordpress/i18n": "^4.41.0",
    "react-router-dom": "^6.15.0"
  },
  "watch": {
    "test": ""
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "typescript": "^5.9.0"
  },
  "optionalDependencies": {
    "@wordpress/env": "^11.6.0"
  }
}
